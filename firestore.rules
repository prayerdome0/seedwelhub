rules_version = '2';

// Seedwel Hub — Cloud Firestore security rules.
//
// Frontend-only checks are NEVER security. These rules are the enforcement
// layer: they prevent ordinary users from promoting themselves to admin,
// reading private data, or modifying other people's / businesses' data.
//
// NOTE: helper functions MUST live inside the service/match blocks. Declaring
// them at the top of the file (outside `service cloud.firestore`) is a syntax
// error and stops the rules from deploying at all.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // Is the caller signed in?
    function signedIn() {
      return request.auth != null;
    }

    // Is the caller this document's owner?
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Returns the role of a user from the users collection. Reads made by rule
    // evaluation (get/exists) are performed by the rules engine itself, so
    // they are not blocked by the read rules below.
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    // Is the caller an admin?
    function isAdmin() {
      return signedIn() && userRole(request.auth.uid) == 'admin';
    }

    // ---------- messaging helpers ----------

    // Is the caller a participant of this conversation?
    function isConversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    // Is the caller an admin of this group? Roles are mirrored on the group
    // document (`creatorId` / `adminIds`) because rules cannot query the
    // membership collection.
    function isGroupAdmin(groupId) {
      return signedIn()
        && (get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds);
    }

    // Message fields ANY participant may toggle on someone else's message:
    // reactions (per-emoji uid lists), personal stars, group pins and the
    // receipt lists. Text/media bodies are excluded — only the sender may
    // change those.
    function communalMessageUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'reactions',
        'starredBy',
        'pinned',
        'pinnedBy',
        'pinnedAt',
        'readBy',
        'deliveredTo',
        'updatedAt'
      ])
      && ((resource.data.conversationId != null
           && isConversationParticipant(resource.data.conversationId))
          || resource.data.groupId != null);
    }

    // Group fields ordinary members keep fresh while chatting: the membership
    // mirror + count (join/leave), the inbox preview and the ephemeral
    // typing/presence maps. Settings, announcements and admin lists are NOT
    // communal — they require group-admin rights.
    function communalGroupUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'memberIds',
        'memberCount',
        'lastMessage',
        'lastMessageAt',
        'typing',
        'presence',
        'updatedAt'
      ]);
    }

    // Does the caller own the business with this id? Used where a document
    // only carries a businessId (orders, payments, quotations, invoices,
    // receipts, payment methods, ...).
    function ownsBusiness(businessId) {
      return signedIn()
        && businessId != null
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self sign-up only, and never as an admin.
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      // Owners may update their own non-sensitive fields, but never role or
      // accountStatus. Admins may update anything (including role).
      // NOTE: diff() must be called on the whole data map — calling it on a
      // single (string) field errors out and silently blocks every update.
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']));
      allow delete: if isAdmin();
    }

    // ---------- profiles ----------
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- businesses ----------
    match /businesses/{businessId} {
      allow read: if true; // business profiles are public
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsBusiness(businessId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- business members ----------
    match /businessMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- products ----------
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- services ----------
    match /services/{serviceId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- categories ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.buyerId)
        || (signedIn() && request.auth.uid == resource.data.ownerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.buyerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }

    // ---------- order items ----------
    match /orderItems/{itemId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.buyerId)
        || (signedIn() && request.auth.uid == resource.data.ownerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- payments ----------
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && (request.auth.uid == resource.data.buyerId || ownsBusiness(resource.data.businessId)));
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }

    // ---------- payment methods / proofs / disputes ----------
    // Seller payment details are NOT public. Exposing account numbers on a
    // public profile is exactly how buyers get redirected to a scammer's
    // account, so reads are limited to the owning seller, admins, and any
    // signed-in buyer who is actively transacting (the client only requests
    // them from a verified order/invoice context - see sellerPaymentService).
    match /paymentMethods/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || ownsBusiness(resource.data.businessId);
    }

    // Payment proofs are evidence in a dispute. Only the buyer who submitted
    // them, the seller being paid and admins may read them. Critically, a
    // buyer may NOT update their own proof after submission - otherwise the
    // amount or reference could be altered after the seller reviewed it.
    // Review decisions belong to the seller/admin alone.
    match /paymentProofs/{id} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.buyerId)
        || (signedIn() && request.auth.uid == resource.data.ownerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.ownerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }
    match /paymentDisputes/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- quotations / invoices / receipts ----------
    // These documents are deliberately world-readable: they are shared with
    // customers (who may not have accounts) and carry a public verification
    // code used by the /verify/:code page. Write access stays restricted to
    // the customer, the owning business and admins.
    match /quotations/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.customerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }
    match /invoices/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.customerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }
    match /receipts/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.customerId)
        || (signedIn() && ownsBusiness(resource.data.businessId));
      allow delete: if isAdmin();
    }

    // ---------- conversations / messages (private) ----------
    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAdmin();
    }
    match /messages/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      // The sender may edit/delete their message; any participant may add
      // themselves to readBy (read receipts) and deliveredTo (delivery
      // receipts). Beyond that, participants of the message's conversation
      // (and members of its group) may update only the COMMUNAL fields —
      // reactions, stars and pins — so nobody can rewrite someone else's text.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.senderId)
        || (signedIn() && request.auth.uid in request.resource.data.readBy)
        || (signedIn() && communalMessageUpdate());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.senderId);
    }

    // ---------- groups / group members ----------
    match /groups/{id} {
      allow read: if resource.data.visibility == 'public' || isAdmin() || signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.creatorId)
        || (signedIn() && request.auth.uid in resource.data.adminIds)
        || (signedIn() && communalGroupUpdate());
      allow delete: if isAdmin();
    }
    match /groupMembers/{id} {
      allow read: if signedIn();
      // Members may join themselves; group admins may add other people.
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.uid == request.auth.uid)
        || (signedIn() && isGroupAdmin(request.resource.data.groupId));
      // Members manage their own doc (e.g. muting); admins manage anyone's.
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && isGroupAdmin(resource.data.groupId));
      // Removal is an admin action (the service soft-deletes via status, but
      // hard deletes stay admin-only for audit safety).
      allow delete: if isAdmin() || (signedIn() && isGroupAdmin(resource.data.groupId));
    }

    // ---------- notifications ----------
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      // The client-side app notifies the other party (order placed, message
      // received, ...), so any signed-in user may create notifications; only
      // the recipient can read or update them.
      allow create: if isAdmin() || signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- device tokens ----------
    match /deviceTokens/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- reviews / wishlists / follows ----------
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /wishlists/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.followerId == request.auth.uid);
    }

    // ---------- documents (verification uploads) ----------
    match /documents/{id} {
      allow read: if isAdmin() || signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ---------- admin-only collections ----------
    // Immutable audit trail: append-only by design. Entries record who did
    // what and when, and can never be edited or removed - not even by an
    // admin - so the history stays trustworthy as evidence.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if false;
      allow delete: if false;
    }
    // Security events form part of the audit trail. The app records them as a
    // side effect of privileged actions, so signed-in users may append, but
    // only admins can read, amend or resolve them - and nobody can delete.
    match /securityEvents/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /adminActions/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /subscriptions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /supportTickets/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- inventory / warehouses (sellers) ----------
    match /inventory/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
    match /inventoryMovements/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /warehouses/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- product variants / customers / stores ----------
    match /productVariants/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }
    match /customers/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow delete: if isAdmin();
    }
    match /stores/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow delete: if isAdmin();
    }
    match /quotationItems/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /invoiceItems/{id} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    // ---------- document number counters ----------
    // Sequential Seedwel Hub document numbers (SH-RCP-000001, ...). Any signed
    // in user may allocate the next number as part of creating a document, but
    // counters can never be deleted or read anonymously.
    match /counters/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /deviceSessions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}

# Seedwel Hub — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in the values for your
# environment. The values below are the application's defaults already compiled
# into the source; the `.env` file is only needed to override them. NEVER commit
# a real `.env` file to GitHub.
#
# These are all PUBLIC client configuration values (safe for the browser).
# Private server credentials (e.g. the FCM VAPID private key or a Cloudinary
# API secret) must never appear here — keep them on the server.

# ---- Firebase (public web config) ----
VITE_FIREBASE_API_KEY=AIzaSyDLqKqyR5yEDTZHAF0uxVf7bo1gPF9z89E
VITE_FIREBASE_AUTH_DOMAIN=phiko-trading.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=phiko-trading
VITE_FIREBASE_STORAGE_BUCKET=phiko-trading.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=502225836758
VITE_FIREBASE_APP_ID=1:502225836758:web:6ef2df26362622b359c777

# ---- Firebase Cloud Messaging (public VAPID key only) ----
# The private VAPID key must remain in the Firebase project settings (server
# side) and must never be placed in client code, public/, or committed.
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# ---- Cloudinary (public unsigned upload preset) ----
# Cloudinary currently has NO folders — do not create or require them.
VITE_CLOUDINARY_CLOUD_NAME=nqyylkmd
VITE_CLOUDINARY_UPLOAD_PRESET=seedwel
